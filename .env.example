DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-32-characters-minimum
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=rh
POSTGRES_USER=rh
POSTGRES_PASSWORD=rh
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
REDIS_CHANNELS_URL=redis://localhost:6379/1

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_CANDIDATOS_CURRICULOS=candidatos-curriculos

CORS_ALLOW_ALL_ORIGINS=True

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CURRICULO_EXTRACTOR_CLASS=apps.candidatos.extractors.groq_extractor.GroqCurriculoExtractor

TRIAGEM_IA_EXTRACTOR_CLASS=apps.candidatos.extractors.groq_triagem_extractor.GroqTriagemIaExtractor
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRIAGEM_IA_ENCRYPTION_KEY=

# "Conectar com Google" (Gmail) na Triagem por IA — criar em
# https://console.cloud.google.com (Gmail API + tela de consentimento OAuth
# + Client ID tipo "Web application"). REDIRECT_URI precisa estar cadastrada
# lá, idêntica.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/v1/triagem-ia-google/callback/
TRIAGEM_IA_FRONTEND_URL=http://localhost:5173/config/triagem-ia
